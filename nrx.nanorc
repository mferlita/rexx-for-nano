syntax "netrexx" "\.nrx$"

# ==============================================================================
# NetRexx is case-insensitive, but regex syntax highlighting can confuse words
# important to Rexx. To avoid confusion a certain style is recommended. Keywords
# and related syntax are capitalized. Variables should use camelCase or 
# snake_case. Class and method names should use PascalCase and camelCase 
# respectively. Avoid using using words important to Rexx, even when lowercased,
# when using GNU/nano for editting NetRexx programs.
# ==============================================================================

# To select a theme, comment out the current theme and uncomment the desired
# one.

# ==============================================================================
# Default : Basic Colors
# ==============================================================================
# Classes/types/annotations
color blue CLASS +[A-Za-z0-9]+ *((implements|extends) +[A-Za-z0-9.]+)?"
color blue "boolean|byte|char|double|float|int|long|short|Rexx|String|void"
color blue "@[A-Za-z]+"

# Methods and Functions
color lightblue "METHOD +[A-Za-z0-9]+"
color lightblue "[A-Za-z_][A-Za-z0-9_]*[[:space:]]*[(]"

# Keywords
color magenta "\<(OPTIONS|PACKAGE)\>"
color magenta "\<(CASE|CATCH|CONSTANT|DEFAULT|DO|ELSE|END|EXTENDS|FINALLY|FOR)\>"
color magenta "\<(FOREVER|IF|LOOP|OVER|RETURN|SELECT|SWITCH|THEN|THIS|THROW)\>"
color magenta "\<(TRANSIENT|TRY|WHEN|WHILE|BREAK|CONTINUE|EXIT|ITERATE|LEAVE)\>"
color magenta "\<(TO|BY|UNTIL|OTHERWISE)\>"
color magenta "\<(PROPERTIES|PARSE|SAY|SIGNAL|TRACE|ADDRESS|CALL|INTERPRET)\>"
color magenta "\<(NUMERIC|NOP|PUSH|QUEUE|DROP|ASK|PROCEDURE|EXPOSE|HIDE)\>"
color magenta "\<(ABSTRACT|ADAPTER|BINARY|CLASS|EXTENDS|FINAL)\>"
color magenta "\<(IMPLEMENTS|IMPORT|INSTANCEOF|DEPENDENT|DEPRECATED)\>"
color magenta "\<(DIGITS|FINAL|INTERFACE|NATIVE|PRIVATE|PROTECTED)\>"
color magenta "\<(PUBLIC|STATIC|INPACKAGE|SHARED|MINOR|PARENT|UNUSED)\>"
color magenta "\<(BINARY|NOBINARY|DECIMAL|NODECIMAL)\>"
color magenta "\<(ENGINEERING|FORM|SCIENTIFIC|STRICTFP|SUPER|SYNCHRONIZED)\>"
color magenta "\<(THROWS|VOLATILE)\>"
color magenta "\<(FUZZ)\>"

# Constants and Numbers
color lightred "\<(true|false|null)\>"
color lightred "\<([0-9._]+|0x[A-Fa-f0-9_]+|0b[0-1_]+)[FL]?\>"

# Operators
color cyan "[-+=<>?:!~%&|]"

# Strings
color green ""(\\.|[^"])*"|'(\\.|[^'])*'"

# Escape sequences
color lightmagenta "\\([btnfr]|'|\"|\\)"
color lightmagenta "\\u[A-Fa-f0-9]{4}"

# Comments
color lightblack start="/\*" end="\*/"
color lightblack "^--"
color lightblack start="--" end="$"
color lightblack "/\*\*"
color lightblack start="/\*\*" end="\*/"
color lightblack "(^|[[:space:]])//.*"

# TODO
color white,cyan "TODO:?"

