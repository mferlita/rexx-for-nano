## Syntax highlighting for NetRexx

syntax "netrexx" "\.nrx$"

# Annotations
icolor magenta "@[A-Za-z]+"

# Options & Package
icolor brightred "\<(options|package|import)\>"
icolor brightred "\<(strictargs|strictassign|strictcase|strictimport|strictprops|annotate|noannotate)\>"

# Class & Method Declarations
icolor blue "\<class +[A-Za-z0-9_$]+"
icolor blue "\<interface +[A-Za-z0-9_$]+"
icolor blue "\<exception +[A-Za-z0-9_$]+"
icolor blue "\<method +[A-Za-z0-9_$]+"
icolor blue "\<properties\>"

# Function/Method Calls
icolor brightblue "[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("

# Inheritance
icolor brightblue "\<(extends|implements)\>"

# Types
icolor green "\<(boolean|byte|char|double|float|int|long|short|Rexx|String|void)\>"

# Control Flow
icolor brightblue "\<(do|else|end|if|then)\>"
icolor brightblue "\<(loop|forever|while|until|over|to|by|for)\>"
icolor brightblue "\<(select|when|otherwise)\>"
icolor brightblue "\<(leave|iterate)\>"

# Exceptions
icolor brightblue "\<(catch|finally|signal)\>"

# Other Instructions
icolor brightblue "\<(address|ask|exit|interpret|nop|numeric|parse|return|say|trace|use)\>"

# Modifiers 
icolor brightblack "\<(abstract|public|private|protected|static|final|shared|constant)\>"
icolor brightblack "\<(binary|nobinary|decimal|nodecimal)\>"
icolor brightblack "\<(signals|returns)\>"

# Instruction sub-keywords
icolor green "\<(arg|linein|upper|value|var|version|pull|strict|all)\>"
icolor green "\<(digits|form|fuzz|scientific|engineering)\>"

# Special Words
icolor green "\<(this|super)\>"
icolor green "\<(null)\>"

# Operators
color red "[-+=<>?:!~%&|]"

# Numbers
color blue "\<[0-9]+(\.[0-9]*)?\>"
color blue "\<[0-9]+(\.[0-9]*)?[Ee][-+]?[0-9]+\>"
color blue "16x'[0-9A-Fa-f]+'"
color blue "8b'[01]+'"

# Strings
color red "'(\\.|[^'])*'"
color red "\"(\\.|[^\"])*\""
color red "`[^`]*`"

# Comments
color cyan "^--.*"
color cyan start="--" end="$"
color cyan start="/\*" end="\*/"

# TODO
icolor brightwhite,cyan "TODO:?.*"
